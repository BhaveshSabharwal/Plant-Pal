<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_green"
    tools:context=".MainActivity3">

    <!-- Top Left Icon (Plants Icon) -->
    <ImageView
        android:id="@+id/topLeftIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_cluster"
        android:contentDescription="Plants Icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginTop="60dp"/>

    <!-- Top Right Icon (Profile Icon) -->
    <ImageView
        android:id="@+id/profileIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_profile"
    android:contentDescription="Profile Icon"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    android:layout_marginEnd="20dp"
    android:layout_marginTop="60dp"/>

    <!-- "My Account" Text -->
    <TextView
        android:id="@+id/myAccountText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Account"
        android:textSize="24sp"
        android:textColor="@android:color/white"
        android:fontFamily="casual"
        app:layout_constraintTop_toBottomOf="@id/topLeftIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="90dp"/>

    <!-- "My Plants" Text with Underline -->
    <TextView
        android:id="@+id/myPlantsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Plants"
        android:textSize="24sp"
        android:textColor="@android:color/white"
        android:fontFamily="casual"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/myAccountText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Home Icon -->
    <ImageView
        android:id="@+id/homeIcon"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/ic_home"
        android:contentDescription="Home Icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
